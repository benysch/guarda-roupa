# Gemini (google-genai)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Supabase — use a SERVICE ROLE key (server-side only, nunca no cliente)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=wardrobe

# Pipeline
CONFIDENCE_THRESHOLD=0.55

# Telegram (apenas para o bot serverless na Vercel)
TELEGRAM_BOT_TOKEN=123456:ABC-token-do-BotFather
TELEGRAM_ALLOWED_IDS=11111111,22222222   # IDs numéricos do Telegram (você e a Beny)
TELEGRAM_WEBHOOK_SECRET=uma-string-secreta-aleatoria
